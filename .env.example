# Android emulator can access the host backend using 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4003/api
# Actual Expo project UUID; required for remote push, not local notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional path supplied as an Expo Services file environment variable for FCM.
GOOGLE_SERVICES_JSON=
